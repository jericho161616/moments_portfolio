---
const frameCount = 84;
---

<section class="grid min-h-[88vh] border-b border-line md:grid-cols-[1.1fr_1fr]">
  <div class="flex flex-col justify-center gap-6 px-6 py-16 sm:px-10 md:py-0 lg:px-20">
    <span class="text-[11px] uppercase tracking-[0.2em] text-accent">Portfolio — Selected Work</span>
    <h1 class="text-balance font-serif text-6xl leading-[0.98] tracking-tight sm:text-7xl lg:text-8xl">
      Light, held<br /><em class="font-normal italic text-ink-soft">still.</em>
    </h1>
    <p class="max-w-[46ch] text-base leading-relaxed text-ink-soft">
      A collection of shoots across black &amp; white, color, and 35mm film —
      quiet frames shot between now and the next roll.
    </p>
    <div class="mt-2 flex flex-wrap gap-7 text-xs uppercase tracking-widest text-ink-soft">
      <div>
        <strong class="mb-0.5 block font-serif text-sm font-normal not-italic normal-case tracking-normal text-ink">
          {frameCount} frames
        </strong>
        Currently indexed
      </div>
      <div>
        <strong class="mb-0.5 block font-serif text-sm font-normal not-italic normal-case tracking-normal text-ink">
          Lucena, Quezon
        </strong>
        Based in
      </div>
    </div>
  </div>

  <div class="relative overflow-hidden border-t border-line md:border-l md:border-t-0">
    <div
      class="absolute inset-0 bg-[linear-gradient(155deg,#3a3630_0%,#201e1a_45%,#0d0c0a_100%)]"
    >
    </div>
    <div class="absolute left-5 bottom-5 text-[11px] uppercase tracking-widest text-white/50">
      Placeholder plate — your photo goes here
    </div>
  </div>
</section>
