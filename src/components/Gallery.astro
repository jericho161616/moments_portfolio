---
import { photos, categoryLabel, type Category } from "../data/photos";

const filters: { key: Category | "all"; label: string }[] = [
  { key: "all", label: "All" },
  { key: "bw", label: "Black & White" },
  { key: "film", label: "Film" },
  { key: "events", label: "Events" },
  { key: "portraits", label: "Portraits" },
  { key: "travel", label: "Travel" },
];

// Deterministic placeholder gradients + aspect ratios, cycling through a small palette
// so empty tiles still read as an organic masonry wall before real photos land.
const swatches = [
  { bg: "linear-gradient(160deg,#5b5850,#2a2823 60%,#111 100%)", ratio: "4 / 5" },
  { bg: "linear-gradient(200deg,#c9895f,#7a4128 55%,#2a1610 100%)", ratio: "1 / 1" },
  { bg: "linear-gradient(140deg,#7d8a72,#3d4536 60%,#181b14 100%)", ratio: "3 / 4" },
  { bg: "linear-gradient(210deg,#e3b23c,#a24d33 55%,#3a1a15 100%)", ratio: "5 / 4" },
  { bg: "linear-gradient(150deg,#8f8a7e,#4a463d 55%,#1a1815 100%)", ratio: "1 / 1" },
  { bg: "linear-gradient(190deg,#7fa5c9,#3c5b78 55%,#12181e 100%)", ratio: "4 / 3" },
];
---

<section id="gallery" class="scroll-mt-20">
  <div class="flex flex-wrap items-center justify-between gap-4 px-5 py-6 sm:px-10">
    <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter photos by category">
      {
        filters.map((f) => (
          <button
            type="button"
            role="tab"
            data-filter={f.key}
            aria-selected={f.key === "all" ? "true" : "false"}
            class="filter-chip rounded-full border border-line px-4 py-2 text-xs uppercase tracking-widest text-ink-soft transition-colors hover:border-ink hover:text-ink aria-selected:border-ink aria-selected:bg-ink aria-selected:text-paper"
          >
            {f.label}
          </button>
        ))
      }
    </div>
    <span class="text-xs tabular-nums tracking-wide text-ink-soft" id="gallery-count">
      {photos.length} of {photos.length}
    </span>
  </div>

  <div class="columns-2 gap-6 px-5 sm:columns-3 sm:gap-8 sm:px-10 lg:columns-4 xl:columns-5" id="gallery-grid">
    {
      photos.map((photo, i) => (
        <button
          type="button"
          data-category={photo.category}
          data-image={photo.image ?? ""}
          data-title={photo.title}
          class={`gallery-tile group relative mb-6 block w-full overflow-hidden bg-paper-2 text-left opacity-100 [break-inside:avoid] sm:mb-8 ${
            photo.image ? "cursor-zoom-in" : "cursor-default"
          } ${photo.category === "film" ? "film-tile" : ""}`}
        >
          <span class="pointer-events-none absolute inset-0 z-10 shadow-[inset_0_0_0_0px_var(--paper)] transition-[box-shadow] duration-500 ease-out group-hover:shadow-[inset_0_0_0_8px_var(--paper)]" />
          {photo.image ? (
            <img
              src={photo.image}
              alt={photo.title}
              loading={i < 4 ? "eager" : "lazy"}
              class="block w-full scale-[1.05] grayscale-[0.7] transition-[transform,filter] duration-700 ease-out group-hover:scale-[1.12] group-hover:grayscale-0"
            />
          ) : (
            <div
              class="w-full scale-[1.05] grayscale-[var(--gs,0.7)] transition-[transform,filter] duration-700 ease-out group-hover:scale-[1.12] group-hover:grayscale-0"
              style={`aspect-ratio:${swatches[i % swatches.length].ratio};background:${swatches[i % swatches.length].bg};${
                photo.category === "bw" ? "--gs:1;" : ""
              }`}
            />
          )}
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 flex translate-y-2 items-end justify-between gap-2 bg-gradient-to-t from-black/55 to-transparent px-4 py-3 text-white opacity-0 transition-[opacity,transform] duration-300 ease-out group-hover:translate-y-0 group-hover:opacity-100">
            <span class="font-serif text-sm italic">{photo.title}</span>
            <span class="text-[10px] uppercase tracking-widest opacity-75">
              {categoryLabel[photo.category]}
            </span>
          </div>
        </button>
      ))
    }
  </div>

  <p class="px-5 py-6 text-center text-[11px] text-ink-soft sm:px-10">
    Tiles without a photo yet are placeholders — drop a file in{" "}
    <code class="rounded bg-paper-2 px-1 py-0.5">public/images/</code> and set its{" "}
    <code class="rounded bg-paper-2 px-1 py-0.5">image</code> path in{" "}
    <code class="rounded bg-paper-2 px-1 py-0.5">src/data/photos.ts</code> to replace it.
  </p>
</section>

<style>
  .film-tile::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 10px;
    background-image: radial-gradient(circle, rgba(0, 0, 0, 0.5) 2.5px, transparent 2.6px);
    background-size: 16px 10px;
    background-repeat: repeat-x;
    opacity: 0.35;
    z-index: 2;
  }

  .gallery-tile.tile-fade {
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
  }
  .gallery-tile {
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
</style>

<script>
  const FADE_MS = 450;
  const chips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
  const tiles = document.querySelectorAll<HTMLButtonElement>(".gallery-tile");
  const countEl = document.getElementById("gallery-count");
  const total = tiles.length;

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute("aria-selected", c === chip ? "true" : "false"));

      let visible = 0;
      tiles.forEach((tile) => {
        const match = filter === "all" || tile.dataset.category === filter;
        if (match) {
          tile.classList.remove("hidden");
          requestAnimationFrame(() => tile.classList.remove("tile-fade"));
          visible += 1;
        } else {
          tile.classList.add("tile-fade");
          window.setTimeout(() => tile.classList.add("hidden"), FADE_MS);
        }
      });

      if (countEl) countEl.textContent = `${visible} of ${total}`;
    });
  });

  tiles.forEach((tile) => {
    tile.addEventListener("click", () => {
      const src = tile.dataset.image;
      const title = tile.dataset.title ?? "";
      if (!src) return;
      document.dispatchEvent(new CustomEvent("open-lightbox", { detail: { src, title } }));
    });
  });
</script>
