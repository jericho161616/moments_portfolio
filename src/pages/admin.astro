---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Admin — Echo" description="Photo upload — not for public browsing.">
  <main class="mx-auto max-w-3xl px-5 py-14 sm:px-10">
    <a href="/" class="text-xs uppercase tracking-widest text-ink-soft hover:text-ink">&larr; Back to site</a>
    <h1 class="mt-4 font-serif text-3xl italic">Add photos</h1>
    <p class="mt-2 max-w-[60ch] text-sm leading-relaxed text-ink-soft">
      Pick your files, set a title/category/size for each, then hit Publish once. Everything
      goes out as a single commit and the live site rebuilds in about a minute.
    </p>

    <div class="mt-8 border-t border-line pt-8">
      <label class="block text-xs uppercase tracking-widest text-ink-soft" for="password">
        Admin password
      </label>
      <input
        id="password"
        type="password"
        autocomplete="current-password"
        class="mt-2 w-full max-w-xs rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-ink"
        placeholder="Enter password"
      />
    </div>

    <div class="mt-8 border-t border-line pt-8">
      <label
        for="file-input"
        class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border border-dashed border-line px-6 py-14 text-center text-ink-soft transition-colors hover:border-ink hover:text-ink"
      >
        <span class="text-sm">Click to choose photos, or drag them here</span>
        <span class="text-xs uppercase tracking-widest">JPG / PNG — keep each under ~2MB</span>
      </label>
      <input id="file-input" type="file" accept="image/*" multiple class="hidden" />
    </div>

    <ul id="staged-list" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2"></ul>

    <div class="mt-8 flex items-center gap-4 border-t border-line pt-8">
      <button
        id="publish-btn"
        type="button"
        disabled
        class="rounded-full bg-ink px-6 py-2.5 text-xs uppercase tracking-widest text-paper transition-opacity disabled:cursor-not-allowed disabled:opacity-40"
      >
        Publish
      </button>
      <span id="status" class="text-xs text-ink-soft"></span>
    </div>
  </main>
</Layout>

<template id="card-template">
  <li class="staged-card overflow-hidden rounded-md border border-line">
    <img class="preview h-40 w-full object-cover" alt="" />
    <div class="space-y-2 p-3">
      <input
        class="title-input w-full border-b border-line pb-1 text-sm outline-none focus:border-ink"
        type="text"
        placeholder="Title"
      />
      <div class="flex gap-2">
        <select class="category-select flex-1 rounded border border-line px-2 py-1 text-xs">
          <option value="bw">Black &amp; White</option>
          <option value="color">Color</option>
          <option value="film">Film</option>
        </select>
        <select class="size-select flex-1 rounded border border-line px-2 py-1 text-xs">
          <option value="square">Square</option>
          <option value="wide">Wide</option>
          <option value="tall">Tall</option>
        </select>
      </div>
      <button type="button" class="remove-btn text-xs uppercase tracking-widest text-accent">
        Remove
      </button>
    </div>
  </li>
</template>

<script>
  interface StagedPhoto {
    file: File;
    dataUrl: string;
    title: string;
    category: "bw" | "color" | "film";
    size: "square" | "wide" | "tall";
  }

  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const stagedList = document.getElementById("staged-list") as HTMLUListElement;
  const publishBtn = document.getElementById("publish-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLSpanElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const template = document.getElementById("card-template") as HTMLTemplateElement;

  const staged: StagedPhoto[] = [];

  function titleFromFilename(name: string) {
    return name.replace(/\.[^/.]+$/, "").replace(/[-_]+/g, " ");
  }

  function readAsDataUrl(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function renderCards() {
    stagedList.innerHTML = "";
    staged.forEach((photo, index) => {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const img = node.querySelector<HTMLImageElement>(".preview")!;
      const titleInput = node.querySelector<HTMLInputElement>(".title-input")!;
      const categorySelect = node.querySelector<HTMLSelectElement>(".category-select")!;
      const sizeSelect = node.querySelector<HTMLSelectElement>(".size-select")!;
      const removeBtn = node.querySelector<HTMLButtonElement>(".remove-btn")!;

      img.src = photo.dataUrl;
      titleInput.value = photo.title;
      categorySelect.value = photo.category;
      sizeSelect.value = photo.size;

      titleInput.addEventListener("input", () => (staged[index].title = titleInput.value));
      categorySelect.addEventListener(
        "change",
        () => (staged[index].category = categorySelect.value as StagedPhoto["category"]),
      );
      sizeSelect.addEventListener("change", () => (staged[index].size = sizeSelect.value as StagedPhoto["size"]));
      removeBtn.addEventListener("click", () => {
        staged.splice(index, 1);
        renderCards();
      });

      stagedList.appendChild(node);
    });

    publishBtn.disabled = staged.length === 0;
  }

  fileInput.addEventListener("change", async () => {
    const files = Array.from(fileInput.files ?? []);
    for (const file of files) {
      const dataUrl = await readAsDataUrl(file);
      staged.push({ file, dataUrl, title: titleFromFilename(file.name), category: "color", size: "square" });
    }
    fileInput.value = "";
    renderCards();
  });

  publishBtn.addEventListener("click", async () => {
    if (staged.length === 0) return;

    publishBtn.disabled = true;
    statusEl.textContent = "Publishing…";

    try {
      const res = await fetch("/api/publish", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          password: passwordInput.value,
          photos: staged.map((p) => ({
            title: p.title,
            category: p.category,
            size: p.size,
            filename: p.file.name,
            dataUrl: p.dataUrl,
          })),
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        statusEl.textContent = data.error || "Something went wrong.";
        publishBtn.disabled = false;
        return;
      }

      statusEl.textContent = `Published ${data.added} photo(s). Site is rebuilding — check back in about a minute.`;
      staged.length = 0;
      renderCards();
    } catch (err) {
      statusEl.textContent = "Network error — please try again.";
      publishBtn.disabled = false;
    }
  });
</script>
