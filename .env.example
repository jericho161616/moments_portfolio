# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these under Project Settings -> Environment Variables instead.

# A GitHub Personal Access Token (fine-grained, scoped to this repo only,
# with Contents: Read and write permission). Used by /admin to commit
# uploaded photos + update src/data/photos.ts.
GITHUB_TOKEN=

# Repo the admin page commits to.
GITHUB_OWNER=jericho161616
GITHUB_REPO=moments_portfolio
GITHUB_BRANCH=main

# Password required to publish from /admin. Pick something only you know.
ADMIN_PASSWORD=
