---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { about } from "../data/about";
---

<Layout title={`About — ${about.name}`} description={about.location}>
  <Nav />

  <main class="mx-auto max-w-5xl px-5 py-14 sm:px-10 sm:py-20">
    <div class="grid gap-10 sm:grid-cols-[0.85fr_1.15fr] sm:gap-14">
      <div class="aspect-[4/5] overflow-hidden bg-paper-2">
        {
          about.photo ? (
            <img src={about.photo} alt={about.name} class="h-full w-full object-cover" />
          ) : (
            <div class="h-full w-full bg-[linear-gradient(150deg,#8f8a7e,#4a463d_55%,#1a1815_100%)]" />
          )
        }
      </div>

      <div>
        <span class="text-[11px] uppercase tracking-[0.16em] text-accent">About</span>
        <h1 class="mb-5 mt-2 font-serif text-4xl italic sm:text-5xl">{about.name}</h1>
        {about.bio.map((paragraph) => <p class="mb-4 max-w-[52ch] leading-relaxed text-ink-soft">{paragraph}</p>)}

        <div class="mt-8 flex flex-col gap-2 border-t border-line pt-8">
          <a
            href={about.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-fit border-b border-transparent text-sm transition-colors hover:border-accent hover:text-accent"
          >
            Instagram — {about.instagramHandle}
          </a>
          <a
            href={`mailto:${about.email}`}
            class="w-fit border-b border-transparent text-sm transition-colors hover:border-accent hover:text-accent"
          >
            {about.email}
          </a>
          <span class="text-sm text-ink-soft">{about.location}</span>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
