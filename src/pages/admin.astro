---
import Layout from "../layouts/Layout.astro";
import { photos, categoryLabel } from "../data/photos";
import { about } from "../data/about";
---

<Layout title="Admin — Echo" description="Photo upload — not for public browsing.">
  <main class="mx-auto max-w-3xl px-5 py-14 sm:px-10">
    <a href="/" class="text-xs uppercase tracking-widest text-ink-soft hover:text-ink">&larr; Back to site</a>
    <h1 class="mt-4 font-serif text-3xl italic">Add photos</h1>
    <p class="mt-2 max-w-[60ch] text-sm leading-relaxed text-ink-soft">
      Pick your files, set a title/category for each, then hit Publish once. Everything goes out
      as a single commit and the live site rebuilds in about a minute. The gallery is a masonry
      wall, so photos keep their natural proportions — no need to pick a shape.
    </p>

    <div class="mt-8 border-t border-line pt-8">
      <label class="block text-xs uppercase tracking-widest text-ink-soft" for="password">
        Admin password
      </label>
      <input
        id="password"
        type="password"
        autocomplete="current-password"
        class="mt-2 w-full max-w-xs rounded-md border border-line px-3 py-2 text-sm outline-none focus:border-ink"
        placeholder="Enter password"
      />
    </div>

    <div class="mt-8 border-t border-line pt-8">
      <h2 class="font-serif text-xl italic">About page</h2>
      <p class="mt-1 text-xs text-ink-soft">Edit the photo and details shown on /about. Saves as one commit.</p>

      <div class="mt-4 grid gap-6 sm:grid-cols-[160px_1fr]">
        <div>
          <div id="about-photo-preview" class="aspect-[4/5] w-full overflow-hidden bg-paper-2">
            {
              about.photo ? (
                <img src={about.photo} alt="" class="h-full w-full object-cover" id="about-photo-img" />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-[10px] uppercase tracking-widest text-ink-soft" id="about-photo-img">
                  No photo yet
                </div>
              )
            }
          </div>
          <label
            for="about-photo-input"
            class="mt-2 block w-full cursor-pointer rounded border border-line px-2 py-1.5 text-center text-[10px] uppercase tracking-widest text-ink-soft hover:border-ink hover:text-ink"
          >
            Change photo
          </label>
          <input id="about-photo-input" type="file" accept="image/*" class="hidden" />
        </div>

        <div class="space-y-3">
          <div>
            <label class="block text-[10px] uppercase tracking-widest text-ink-soft" for="about-name">Name</label>
            <input
              id="about-name"
              type="text"
              value={about.name}
              class="mt-1 w-full rounded border border-line px-2 py-1.5 text-sm outline-none focus:border-ink"
            />
          </div>
          <div>
            <label class="block text-[10px] uppercase tracking-widest text-ink-soft" for="about-bio">
              Bio (separate paragraphs with a blank line)
            </label>
            <textarea
              id="about-bio"
              rows="6"
              class="mt-1 w-full rounded border border-line px-2 py-1.5 text-sm outline-none focus:border-ink"
            >{about.bio.join("\n\n")}</textarea>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label class="block text-[10px] uppercase tracking-widest text-ink-soft" for="about-ig-handle">
                Instagram handle
              </label>
              <input
                id="about-ig-handle"
                type="text"
                value={about.instagramHandle}
                class="mt-1 w-full rounded border border-line px-2 py-1.5 text-sm outline-none focus:border-ink"
              />
            </div>
            <div>
              <label class="block text-[10px] uppercase tracking-widest text-ink-soft" for="about-ig-url">
                Instagram URL
              </label>
              <input
                id="about-ig-url"
                type="text"
                value={about.instagramUrl}
                class="mt-1 w-full rounded border border-line px-2 py-1.5 text-sm outline-none focus:border-ink"
              />
            </div>
            <div>
              <label class="block text-[10px] uppercase tracking-widest text-ink-soft" for="about-email">Email</label>
              <input
                id="about-email"
                type="email"
                value={about.email}
                class="mt-1 w-full rounded border border-line px-2 py-1.5 text-sm outline-none focus:border-ink"
              />
            </div>
            <div>
              <label class="block text-[10px] uppercase tracking-widest text-ink-soft" for="about-location">
                Location
              </label>
              <input
                id="about-location"
                type="text"
                value={about.location}
                class="mt-1 w-full rounded border border-line px-2 py-1.5 text-sm outline-none focus:border-ink"
              />
            </div>
          </div>

          <div class="flex items-center gap-4 pt-2">
            <button
              id="save-about-btn"
              type="button"
              class="rounded-full bg-ink px-5 py-2 text-xs uppercase tracking-widest text-paper transition-opacity hover:opacity-90"
            >
              Save about page
            </button>
            <span id="about-status" class="text-xs text-ink-soft"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-line pt-8">
      <h2 class="font-serif text-xl italic">Existing photos</h2>
      <p class="mt-1 text-xs text-ink-soft">
        Reflects the last deploy — refresh after publishing/saving finishes rebuilding to see changes here.
        Drag by the ⠿ handle to reorder. Edit titles/categories inline, then hit one Save button — everything
        changed goes out as a single commit, one redeploy.
      </p>
      <ul id="existing-list" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          photos.map((photo) => (
            <li
              class="existing-item relative overflow-hidden rounded-md border border-line bg-paper"
              data-id={photo.id}
              draggable="true"
            >
              <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between px-2 pt-2">
                <span class="drag-handle cursor-grab select-none rounded bg-ink/60 px-1.5 py-0.5 text-xs leading-none text-paper active:cursor-grabbing">
                  ⠿
                </span>
                <input type="checkbox" class="existing-checkbox h-4 w-4 accent-ink" data-id={photo.id} />
              </div>
              {photo.image ? (
                <img src={photo.image} alt={photo.title} class="h-24 w-full object-cover" draggable="false" />
              ) : (
                <div class="flex h-24 w-full items-center justify-center bg-paper-2 text-[10px] uppercase tracking-widest text-ink-soft">
                  Placeholder
                </div>
              )}
              <div class="space-y-1 p-2">
                <input
                  type="text"
                  class="existing-title-input w-full border-b border-line pb-0.5 text-xs outline-none focus:border-ink"
                  value={photo.title}
                  placeholder="Untitled"
                  data-id={photo.id}
                />
                <select class="existing-category-select w-full rounded border border-line px-1 py-0.5 text-[10px]" data-id={photo.id}>
                  <option value="bw" selected={photo.category === "bw"}>Black &amp; White</option>
                  <option value="film" selected={photo.category === "film"}>Film</option>
                  <option value="events" selected={photo.category === "events"}>Events</option>
                  <option value="portraits" selected={photo.category === "portraits"}>Portraits</option>
                  <option value="travel" selected={photo.category === "travel"}>Travel</option>
                </select>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <button
          id="save-order-btn"
          type="button"
          disabled
          class="rounded-full bg-ink px-5 py-2 text-xs uppercase tracking-widest text-paper transition-opacity disabled:cursor-not-allowed disabled:opacity-40"
        >
          Save changes
        </button>
        <button
          id="delete-selected-btn"
          type="button"
          disabled
          class="rounded-full border border-accent px-5 py-2 text-xs uppercase tracking-widest text-accent transition-opacity disabled:cursor-not-allowed disabled:opacity-40"
        >
          Delete selected (<span id="selected-count">0</span>)
        </button>
        <span id="delete-status" class="text-xs text-ink-soft"></span>
      </div>
    </div>

    <div class="mt-8 border-t border-line pt-8">
      <label
        for="file-input"
        class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-md border border-dashed border-line px-6 py-14 text-center text-ink-soft transition-colors hover:border-ink hover:text-ink"
      >
        <span class="text-sm">Click to choose photos, or drag them here</span>
        <span class="text-xs uppercase tracking-widest">JPG / PNG — keep each under ~2MB</span>
      </label>
      <input id="file-input" type="file" accept="image/*" multiple class="hidden" />
    </div>

    <ul id="staged-list" class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2"></ul>

    <div id="preview-section" class="mt-8 hidden border-t border-line pt-8">
      <h2 class="font-serif text-xl italic">Preview</h2>
      <p class="mt-1 text-xs text-ink-soft">How these photos will sit in the gallery's masonry wall, before you publish.</p>
      <div id="masonry-preview" class="mt-4 columns-2 gap-4 sm:columns-3"></div>
    </div>

    <div class="mt-8 flex items-center gap-4 border-t border-line pt-8">
      <button
        id="publish-btn"
        type="button"
        disabled
        class="rounded-full bg-ink px-6 py-2.5 text-xs uppercase tracking-widest text-paper transition-opacity disabled:cursor-not-allowed disabled:opacity-40"
      >
        Publish
      </button>
      <span id="status" class="text-xs text-ink-soft"></span>
    </div>
  </main>
</Layout>

<template id="card-template">
  <li class="staged-card overflow-hidden rounded-md border border-line">
    <img class="preview h-40 w-full object-cover" alt="" />
    <div class="space-y-2 p-3">
      <input
        class="title-input w-full border-b border-line pb-1 text-sm outline-none focus:border-ink"
        type="text"
        placeholder="Title"
      />
      <select class="category-select w-full rounded border border-line px-2 py-1 text-xs">
        <option value="bw">Black &amp; White</option>
        <option value="film">Film</option>
        <option value="events">Events</option>
        <option value="portraits">Portraits</option>
        <option value="travel">Travel</option>
      </select>
      <button type="button" class="remove-btn text-xs uppercase tracking-widest text-accent">
        Remove
      </button>
    </div>
  </li>
</template>

<script>
  interface StagedPhoto {
    file: File;
    dataUrl: string;
    title: string;
    category: "bw" | "film" | "events" | "portraits" | "travel";
  }

  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const stagedList = document.getElementById("staged-list") as HTMLUListElement;
  const publishBtn = document.getElementById("publish-btn") as HTMLButtonElement;
  const statusEl = document.getElementById("status") as HTMLSpanElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const template = document.getElementById("card-template") as HTMLTemplateElement;
  const previewSection = document.getElementById("preview-section") as HTMLDivElement;
  const masonryPreview = document.getElementById("masonry-preview") as HTMLDivElement;

  const staged: StagedPhoto[] = [];

  function readAsDataUrl(file: File): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result as string);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  const MAX_DIMENSION = 1600;
  const JPEG_QUALITY = 0.72;
  // Vercel's free tier hard-caps a single request body around 4.5MB.
  // Leave headroom for JSON overhead + other fields.
  const MAX_BATCH_BYTES = 3_800_000;

  // Vercel's free tier caps a single request body at 4.5MB, and camera-res
  // photos blow past that fast. Downscale + re-encode as JPEG client-side so
  // several photos still fit in one publish request.
  function compressImage(dataUrl: string): Promise<string> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => {
        let { width, height } = img;
        if (width > MAX_DIMENSION || height > MAX_DIMENSION) {
          const scale = MAX_DIMENSION / Math.max(width, height);
          width = Math.round(width * scale);
          height = Math.round(height * scale);
        }

        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d");
        if (!ctx) {
          resolve(dataUrl);
          return;
        }
        ctx.drawImage(img, 0, 0, width, height);
        resolve(canvas.toDataURL("image/jpeg", JPEG_QUALITY));
      };
      img.onerror = reject;
      img.src = dataUrl;
    });
  }

  function renderPreview() {
    masonryPreview.innerHTML = "";
    previewSection.classList.toggle("hidden", staged.length === 0);

    staged.forEach((photo) => {
      const tile = document.createElement("div");
      tile.className = "mb-4 overflow-hidden bg-paper-2 [break-inside:avoid]";
      const img = document.createElement("img");
      img.src = photo.dataUrl;
      img.alt = photo.title;
      img.className = "block w-full";
      tile.appendChild(img);
      masonryPreview.appendChild(tile);
    });
  }

  function renderCards() {
    stagedList.innerHTML = "";
    staged.forEach((photo, index) => {
      const node = template.content.cloneNode(true) as DocumentFragment;
      const img = node.querySelector<HTMLImageElement>(".preview")!;
      const titleInput = node.querySelector<HTMLInputElement>(".title-input")!;
      const categorySelect = node.querySelector<HTMLSelectElement>(".category-select")!;
      const removeBtn = node.querySelector<HTMLButtonElement>(".remove-btn")!;

      img.src = photo.dataUrl;
      titleInput.value = photo.title;
      categorySelect.value = photo.category;

      titleInput.addEventListener("input", () => {
        staged[index].title = titleInput.value;
        renderPreview();
      });
      categorySelect.addEventListener(
        "change",
        () => (staged[index].category = categorySelect.value as StagedPhoto["category"]),
      );
      removeBtn.addEventListener("click", () => {
        staged.splice(index, 1);
        renderCards();
      });

      stagedList.appendChild(node);
    });

    publishBtn.disabled = staged.length === 0;
    renderPreview();
  }

  fileInput.addEventListener("change", async () => {
    const files = Array.from(fileInput.files ?? []);
    statusEl.textContent = files.length ? "Preparing photos…" : "";
    for (const file of files) {
      const rawDataUrl = await readAsDataUrl(file);
      const dataUrl = await compressImage(rawDataUrl);
      staged.push({ file, dataUrl, title: "", category: "travel" });
    }
    statusEl.textContent = "";
    fileInput.value = "";
    renderCards();
  });

  function chunkBySize(photos: StagedPhoto[]): StagedPhoto[][] {
    const chunks: StagedPhoto[][] = [];
    let current: StagedPhoto[] = [];
    let currentBytes = 0;

    for (const photo of photos) {
      const size = photo.dataUrl.length;
      if (current.length > 0 && currentBytes + size > MAX_BATCH_BYTES) {
        chunks.push(current);
        current = [];
        currentBytes = 0;
      }
      current.push(photo);
      currentBytes += size;
    }
    if (current.length > 0) chunks.push(current);
    return chunks;
  }

  async function publishChunk(chunk: StagedPhoto[]) {
    const res = await fetch("/api/publish", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        password: passwordInput.value,
        photos: chunk.map((p) => ({
          title: p.title,
          category: p.category,
          filename: p.file.name,
          dataUrl: p.dataUrl,
        })),
      }),
    });

    let data: { error?: string; added?: number } = {};
    try {
      data = await res.json();
    } catch {
      // Non-JSON response — likely rejected by the platform before reaching our code.
    }

    if (!res.ok) {
      if (res.status === 413) {
        throw new Error("That batch is still too large for one request — try fewer photos at a time.");
      }
      throw new Error(data.error || `Publish failed (status ${res.status}).`);
    }

    return data.added ?? chunk.length;
  }

  publishBtn.addEventListener("click", async () => {
    if (staged.length === 0) return;

    publishBtn.disabled = true;
    const chunks = chunkBySize(staged);
    let published = 0;

    try {
      for (let i = 0; i < chunks.length; i++) {
        statusEl.textContent =
          chunks.length > 1 ? `Publishing batch ${i + 1} of ${chunks.length}…` : "Publishing…";
        published += await publishChunk(chunks[i]);
      }

      statusEl.textContent = `Published ${published} photo(s). Site is rebuilding — check back in about a minute.`;
      staged.length = 0;
      renderCards();
    } catch (err) {
      statusEl.textContent = err instanceof Error ? err.message : "Something went wrong — please try again.";
      publishBtn.disabled = false;
    }
  });

  const existingCheckboxes = document.querySelectorAll<HTMLInputElement>(".existing-checkbox");
  const deleteSelectedBtn = document.getElementById("delete-selected-btn") as HTMLButtonElement;
  const selectedCountEl = document.getElementById("selected-count") as HTMLSpanElement;
  const deleteStatusEl = document.getElementById("delete-status") as HTMLSpanElement;

  function updateSelectedCount() {
    const count = document.querySelectorAll<HTMLInputElement>(".existing-checkbox:checked").length;
    selectedCountEl.textContent = String(count);
    deleteSelectedBtn.disabled = count === 0;
  }

  existingCheckboxes.forEach((cb) => cb.addEventListener("change", updateSelectedCount));

  deleteSelectedBtn.addEventListener("click", async () => {
    const checked = Array.from(document.querySelectorAll<HTMLInputElement>(".existing-checkbox:checked"));
    if (checked.length === 0) return;

    if (!window.confirm(`Delete ${checked.length} photo(s)? This removes them from the site on the next rebuild.`)) {
      return;
    }

    deleteSelectedBtn.disabled = true;
    deleteStatusEl.textContent = "Deleting…";

    try {
      const ids = checked.map((cb) => cb.dataset.id).filter((id): id is string => Boolean(id));
      const res = await fetch("/api/delete-photo", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: passwordInput.value, ids }),
      });

      let data: { error?: string; removed?: number } = {};
      try {
        data = await res.json();
      } catch {
        // ignore non-JSON response
      }

      if (!res.ok) {
        deleteStatusEl.textContent = data.error || `Delete failed (status ${res.status}).`;
        deleteSelectedBtn.disabled = false;
        return;
      }

      checked.forEach((cb) => cb.closest(".existing-item")?.remove());
      deleteStatusEl.textContent = `Deleted ${data.removed ?? checked.length} photo(s). Site is rebuilding — check back in about a minute.`;
      updateSelectedCount();
    } catch {
      deleteStatusEl.textContent = "Network error deleting photos — please try again.";
      deleteSelectedBtn.disabled = false;
    }
  });

  const existingList = document.getElementById("existing-list") as HTMLUListElement;
  const saveOrderBtn = document.getElementById("save-order-btn") as HTMLButtonElement;
  const originalOrder = Array.from(existingList.querySelectorAll<HTMLLIElement>(".existing-item")).map(
    (li) => li.dataset.id,
  );
  const originalTitles = new Map<string, string>();
  const originalCategories = new Map<string, string>();
  existingList.querySelectorAll<HTMLInputElement>(".existing-title-input").forEach((el) => {
    if (el.dataset.id) originalTitles.set(el.dataset.id, el.value);
  });
  existingList.querySelectorAll<HTMLSelectElement>(".existing-category-select").forEach((el) => {
    if (el.dataset.id) originalCategories.set(el.dataset.id, el.value);
  });

  let dragEl: HTMLLIElement | null = null;

  function currentOrder(): string[] {
    return Array.from(existingList.querySelectorAll<HTMLLIElement>(".existing-item"))
      .map((li) => li.dataset.id)
      .filter((id): id is string => Boolean(id));
  }

  function hasChanges(): boolean {
    const order = currentOrder();
    if (order.length !== originalOrder.length || order.some((id, i) => id !== originalOrder[i])) return true;

    let titleOrCategoryChanged = false;
    existingList.querySelectorAll<HTMLInputElement>(".existing-title-input").forEach((el) => {
      if (el.dataset.id && originalTitles.get(el.dataset.id) !== el.value) titleOrCategoryChanged = true;
    });
    existingList.querySelectorAll<HTMLSelectElement>(".existing-category-select").forEach((el) => {
      if (el.dataset.id && originalCategories.get(el.dataset.id) !== el.value) titleOrCategoryChanged = true;
    });
    return titleOrCategoryChanged;
  }

  function refreshSaveButton() {
    saveOrderBtn.disabled = !hasChanges();
  }

  existingList.querySelectorAll<HTMLInputElement>(".existing-title-input").forEach((el) => {
    el.addEventListener("input", refreshSaveButton);
  });
  existingList.querySelectorAll<HTMLSelectElement>(".existing-category-select").forEach((el) => {
    el.addEventListener("change", refreshSaveButton);
  });

  existingList.querySelectorAll<HTMLLIElement>(".existing-item").forEach((item) => {
    item.addEventListener("dragstart", () => {
      dragEl = item;
      item.classList.add("opacity-40");
    });
    item.addEventListener("dragend", () => {
      item.classList.remove("opacity-40");
      dragEl = null;
      refreshSaveButton();
    });
    item.addEventListener("dragover", (e) => {
      e.preventDefault();
      if (!dragEl || dragEl === item) return;
      const rect = item.getBoundingClientRect();
      const after = (e as DragEvent).clientX - rect.left > rect.width / 2;
      item.parentElement?.insertBefore(dragEl, after ? item.nextSibling : item);
    });
  });

  saveOrderBtn.addEventListener("click", async () => {
    const ids = currentOrder();
    const edits: { id: string; title: string; category: string }[] = [];
    existingList.querySelectorAll<HTMLLIElement>(".existing-item").forEach((item) => {
      const id = item.dataset.id;
      if (!id) return;
      const titleEl = item.querySelector<HTMLInputElement>(".existing-title-input");
      const categoryEl = item.querySelector<HTMLSelectElement>(".existing-category-select");
      edits.push({ id, title: titleEl?.value ?? "", category: categoryEl?.value ?? "" });
    });

    saveOrderBtn.disabled = true;
    deleteStatusEl.textContent = "Saving…";

    try {
      const res = await fetch("/api/save-photos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: passwordInput.value, ids, edits }),
      });

      let data: { error?: string } = {};
      try {
        data = await res.json();
      } catch {
        // ignore non-JSON response
      }

      if (!res.ok) {
        deleteStatusEl.textContent = data.error || `Save failed (status ${res.status}).`;
        saveOrderBtn.disabled = false;
        return;
      }

      originalOrder.length = 0;
      originalOrder.push(...ids);
      edits.forEach((e) => {
        originalTitles.set(e.id, e.title);
        originalCategories.set(e.id, e.category);
      });
      deleteStatusEl.textContent = "Saved. Site is rebuilding — check back in about a minute.";
    } catch {
      deleteStatusEl.textContent = "Network error saving — please try again.";
      saveOrderBtn.disabled = false;
    }
  });

  const aboutPhotoInput = document.getElementById("about-photo-input") as HTMLInputElement;
  const aboutPhotoPreview = document.getElementById("about-photo-preview") as HTMLDivElement;
  const saveAboutBtn = document.getElementById("save-about-btn") as HTMLButtonElement;
  const aboutStatusEl = document.getElementById("about-status") as HTMLSpanElement;
  const aboutNameEl = document.getElementById("about-name") as HTMLInputElement;
  const aboutBioEl = document.getElementById("about-bio") as HTMLTextAreaElement;
  const aboutIgHandleEl = document.getElementById("about-ig-handle") as HTMLInputElement;
  const aboutIgUrlEl = document.getElementById("about-ig-url") as HTMLInputElement;
  const aboutEmailEl = document.getElementById("about-email") as HTMLInputElement;
  const aboutLocationEl = document.getElementById("about-location") as HTMLInputElement;

  let aboutPhotoDataUrl: string | null = null;

  aboutPhotoInput.addEventListener("change", async () => {
    const file = aboutPhotoInput.files?.[0];
    if (!file) return;

    aboutStatusEl.textContent = "Preparing photo…";
    const raw = await readAsDataUrl(file);
    aboutPhotoDataUrl = await compressImage(raw);
    aboutStatusEl.textContent = "";

    aboutPhotoPreview.innerHTML = "";
    const img = document.createElement("img");
    img.src = aboutPhotoDataUrl;
    img.className = "h-full w-full object-cover";
    aboutPhotoPreview.appendChild(img);
  });

  saveAboutBtn.addEventListener("click", async () => {
    const bio = aboutBioEl.value
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .filter(Boolean);

    if (!aboutNameEl.value.trim() || bio.length === 0) {
      aboutStatusEl.textContent = "Name and at least one bio paragraph are required.";
      return;
    }

    saveAboutBtn.disabled = true;
    aboutStatusEl.textContent = "Saving…";

    try {
      const res = await fetch("/api/save-about", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          password: passwordInput.value,
          name: aboutNameEl.value.trim(),
          bio,
          instagramHandle: aboutIgHandleEl.value.trim(),
          instagramUrl: aboutIgUrlEl.value.trim(),
          email: aboutEmailEl.value.trim(),
          location: aboutLocationEl.value.trim(),
          photoDataUrl: aboutPhotoDataUrl,
        }),
      });

      let data: { error?: string } = {};
      try {
        data = await res.json();
      } catch {
        // ignore non-JSON response
      }

      if (!res.ok) {
        aboutStatusEl.textContent = data.error || `Save failed (status ${res.status}).`;
        saveAboutBtn.disabled = false;
        return;
      }

      aboutStatusEl.textContent = "Saved. Site is rebuilding — check back in about a minute.";
      saveAboutBtn.disabled = false;
    } catch {
      aboutStatusEl.textContent = "Network error saving — please try again.";
      saveAboutBtn.disabled = false;
    }
  });
</script>
