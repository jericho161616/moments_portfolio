---
---

<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-ink/90 p-6 opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <button
    id="lightbox-close"
    type="button"
    aria-label="Close"
    class="absolute right-5 top-5 text-3xl leading-none text-paper/80 transition-colors hover:text-paper"
  >
    &times;
  </button>
  <figure class="flex max-h-full max-w-full flex-col items-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[82vh] max-w-[90vw] scale-95 object-contain shadow-2xl transition-transform duration-300 ease-out"
    />
    <figcaption id="lightbox-caption" class="mt-4 font-serif text-sm italic text-paper/90"></figcaption>
  </figure>
</div>

<script>
  const overlay = document.getElementById("lightbox") as HTMLDivElement;
  const imgEl = document.getElementById("lightbox-img") as HTMLImageElement;
  const captionEl = document.getElementById("lightbox-caption") as HTMLElement;
  const closeBtn = document.getElementById("lightbox-close") as HTMLButtonElement;

  function openLightbox(src: string, title: string) {
    imgEl.src = src;
    imgEl.alt = title;
    captionEl.textContent = title;
    overlay.classList.remove("hidden");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";

    requestAnimationFrame(() => {
      overlay.classList.remove("opacity-0");
      imgEl.classList.remove("scale-95");
    });
  }

  function closeLightbox() {
    overlay.classList.add("opacity-0");
    imgEl.classList.add("scale-95");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    window.setTimeout(() => overlay.classList.add("hidden"), 300);
  }

  document.addEventListener("open-lightbox", (e: Event) => {
    const detail = (e as CustomEvent<{ src: string; title: string }>).detail;
    openLightbox(detail.src, detail.title);
  });

  closeBtn.addEventListener("click", closeLightbox);
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay.getAttribute("aria-hidden") === "false") closeLightbox();
  });
</script>
